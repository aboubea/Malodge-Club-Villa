{
  "buildCommand": "npm install --include=dev && npm run build --workspace=packages/shared && npm run build --workspace=apps/backend && npm test && npm run db:migrate --workspace=apps/backend && npm run build --workspace=apps/frontend",
  "outputDirectory": "apps/frontend/dist",
  "installCommand": "npm install --include=dev",
  "framework": null,
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "apps/backend/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/monthly",
      "schedule": "0 6 1 * *"
    }
  ]
}
